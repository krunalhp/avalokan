#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$repo_root"
SECONDS=0

echo "[setup] Checking video and database system packages"
missing=()
for package in libgl1 libglib2.0-0 ffmpeg postgresql-15; do
    if ! dpkg-query -W -f='${Status}' "$package" 2>/dev/null | grep -qx 'install ok installed'; then
        missing+=("$package")
    fi
done
if ((${#missing[@]})); then
    sudo apt-get update -qq
    sudo env DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends "${missing[@]}"
fi
echo "[setup] System libraries ready (${SECONDS}s elapsed)"

# uv is provided by the orb base image. Keep Python and packages pinned in Git.
uv python install "$(cat .python-version)"
uv sync --locked
echo "[setup] Notebook dependencies ready (${SECONDS}s elapsed)"

uv tool install 'specify-cli==1.2.0'
echo "[setup] Spec Kit ready (${SECONDS}s elapsed)"

mkdir -p .data/socket .data/media
chmod 700 .data .data/socket
if [[ ! -f .data/postgres/PG_VERSION ]]; then
    /usr/lib/postgresql/15/bin/initdb -D .data/postgres --auth-local=trust --auth-host=scram-sha-256 --no-instructions
fi
PYTHONPATH=src uv run --locked python -m avalokan.install_model
npm --prefix web ci --no-audit --no-fund
npm --prefix web run build
echo "[setup] Workbench, model and local database prepared (${SECONDS}s elapsed)"

# Amp and supervised services each start in a separate login shell.
# Activate only inside this checkout, never in unrelated repositories.
marker="# Avalokan orb Python environment: $repo_root"
if ! grep -Fqx "$marker" "$HOME/.bash_profile" 2>/dev/null; then
    cat >> "$HOME/.bash_profile" <<EOF

$marker
case "\$PWD/" in
    "$repo_root/"*)
        if [[ -f "$repo_root/.venv/bin/activate" ]] &&
            [[ "\${VIRTUAL_ENV:-}" != "$repo_root/.venv" || "\$(command -v python || true)" != "$repo_root/.venv/bin/python" ]]; then
            source "$repo_root/.venv/bin/activate"
        fi
        case ":\$PATH:" in
            *":\$HOME/.local/bin:"*) ;;
            *) export PATH="\$HOME/.local/bin:\$PATH" ;;
        esac
        ;;
esac
EOF
fi

echo "[setup] Ready (${SECONDS}s total)"
