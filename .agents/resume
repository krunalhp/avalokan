#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
# Amp supervises declared services separately. Do not install on resume.
if [[ ! -x "$repo_root/.venv/bin/python" ]]; then
    echo "[resume] Python environment missing; run .agents/setup" >&2
    exit 1
fi
echo "[resume] Avalokan Python environment ready"
